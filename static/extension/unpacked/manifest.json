{
 "manifest_version": 3,
 "name": "Pets Allowed? \u2014 PetPolicyCheck",
 "short_name": "Pets Allowed?",
 "version": "1.0.1",
 "description": "Instant pet rules on airline and hotel sites: cabin yes/no, fee, carrier size, weight \u2014 verified by PetPolicyCheck.",
 "icons": {
  "16": "icons/icon16.png",
  "48": "icons/icon48.png",
  "128": "icons/icon128.png"
 },
 "action": {
  "default_title": "Pets allowed here?",
  "default_popup": "popup.html",
  "default_icon": {
   "16": "icons/icon16.png",
   "48": "icons/icon48.png"
  }
 },
 "permissions": [
  "activeTab",
  "storage"
 ],
 "content_scripts": [
  {
   "matches": [
    "https://*.aa.com/*",
    "https://*.airbnb.com/*",
    "https://*.aircanada.com/*",
    "https://*.airfrance.com/*",
    "https://*.airfrance.fr/*",
    "https://*.airfrance.us/*",
    "https://*.alaskaair.com/*",
    "https://*.americanairlines.com/*",
    "https://*.ba.com/*",
    "https://*.bestwestern.com/*",
    "https://*.booking.com/*",
    "https://*.britishairways.com/*",
    "https://*.delta.com/*",
    "https://*.druryhotels.com/*",
    "https://*.expedia.com/*",
    "https://*.fourseasons.com/*",
    "https://*.hawaiianairlines.com/*",
    "https://*.hilton.com/*",
    "https://*.hotels.com/*",
    "https://*.ihg.com/*",
    "https://*.jetblue.com/*",
    "https://*.kimptonhotels.com/*",
    "https://*.loewshotels.com/*",
    "https://*.lufthansa.com/*",
    "https://*.marriott.com/*",
    "https://*.motel6.com/*",
    "https://*.redroof.com/*",
    "https://*.southwest.com/*",
    "https://*.united.com/*",
    "https://*.wyndhamhotels.com/*",
    "https://aa.com/*",
    "https://airbnb.com/*",
    "https://aircanada.com/*",
    "https://airfrance.com/*",
    "https://airfrance.fr/*",
    "https://airfrance.us/*",
    "https://alaskaair.com/*",
    "https://americanairlines.com/*",
    "https://ba.com/*",
    "https://bestwestern.com/*",
    "https://booking.com/*",
    "https://britishairways.com/*",
    "https://delta.com/*",
    "https://druryhotels.com/*",
    "https://expedia.com/*",
    "https://fourseasons.com/*",
    "https://hawaiianairlines.com/*",
    "https://hilton.com/*",
    "https://hotels.com/*",
    "https://ihg.com/*",
    "https://jetblue.com/*",
    "https://kimptonhotels.com/*",
    "https://loewshotels.com/*",
    "https://lufthansa.com/*",
    "https://marriott.com/*",
    "https://motel6.com/*",
    "https://redroof.com/*",
    "https://southwest.com/*",
    "https://united.com/*",
    "https://www.aa.com/*",
    "https://wyndhamhotels.com/*"
   ],
   "js": [
    "rules-data.js",
    "match.js",
    "content.js"
   ],
   "run_at": "document_idle"
  }
 ],
 "homepage_url": "https://petpolicycheck.com/"
}
